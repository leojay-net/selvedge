# Server-side Solana RPC used for account reads, transaction history and simulation.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base URL of the agent runtime API (packages/agent-runtime). Leave empty to show the designed empty state on /containment.
SELVEDGE_RUNTIME_URL=
# Wallet-standard chain identifier used when asking a connected wallet to sign.
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
# Cluster suffix appended to public block explorer links.
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet
