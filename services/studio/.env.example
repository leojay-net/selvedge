# Studio service. Every variable is read once at start-up and validated.

# Required. At least 24 characters. The gateway sends it in X-Selvedge-Internal-Token.
SELVEDGE_STUDIO_INTERNAL_TOKEN=

# Where the content store, result cache and job records live. Default: ~/.selvedge-studio
SELVEDGE_STUDIO_HOME=

SELVEDGE_STUDIO_HOST=127.0.0.1
SELVEDGE_STUDIO_PORT=8710
SELVEDGE_STUDIO_WORKER_THREADS=2
SELVEDGE_STUDIO_MAX_BODY_BYTES=262144
SELVEDGE_STUDIO_RATE_LIMIT_PER_MINUTE=120

# Optional binaries when they are not on PATH.
SELVEDGE_STUDIO_FFMPEG=
SELVEDGE_STUDIO_FFPROBE=
SELVEDGE_STUDIO_SOFFICE=

# Director (POST /v1/direct): none | openai_compatible | anthropic
SELVEDGE_STUDIO_DIRECTOR_PROVIDER=none
SELVEDGE_STUDIO_DIRECTOR_MODEL=
# openai_compatible: base URL of an OpenAI-compatible API, and its key
SELVEDGE_STUDIO_DIRECTOR_BASE_URL=
SELVEDGE_STUDIO_DIRECTOR_API_KEY=
# anthropic: the key is read from ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
